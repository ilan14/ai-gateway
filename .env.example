# MySQL host and port reachable from the application container
DB_URL=host.docker.internal
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=replace-with-your-password

# Optional: override the complete JDBC URL (database name, TLS options, etc.)
# SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/ai_gateway

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

DEEP_SEEK_API_KEY=
QWEN_API_KEY=
