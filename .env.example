# 所有应用环境变量通过 Compose env_file 注入容器，不需要逐项修改 Compose。
# MySQL、Redis 通过宿主机已发布的端口连接，不需要共享外部网络。
DB_URL=host.docker.internal
DB_USERNAME=root
DB_PASSWORD=replace-with-your-password
# 非默认端口或数据库名时，取消注释并填写完整连接串。
# SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/ai_gateway?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
DEEP_SEEK_API_KEY=
QWEN_API_KEY=
MOCK_HTTP_SERVER_URL=http://host.docker.internal
MOCK_HTTP_SERVER_PORT=8081
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 -Xms256m -Xmx512m -XX:+UseG1GC -Xlog:gc*,safepoint:file=/app/logs/gc.log:time,uptime,level,tags:filecount=5,filesize=20M -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs"

# 以下为 Compose 部署参数，一般保留默认值即可。
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
APP_MEMORY_LIMIT=1g
